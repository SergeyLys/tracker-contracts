{
	"name": "@SergeyLys/tracker-contracts",
	"version": "1.0.5",
	"description": "Shared TypeScript, Zod and gRPC contracts for microservices",
	"type": "commonjs",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.mjs"
		},
		"./paths": {
			"types": "./dist/paths.d.ts",
			"require": "./dist/paths.js",
			"import": "./dist/paths.mjs"
		}
	},
	"packageManager": "pnpm@10.21.0",
	"files": [
		"dist",
		"proto"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/SergeyLys/tracker-contracts.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsup src/index.ts src/paths.ts --format esm,cjs --external @nestjs/microservices --external rxjs --dts --clean && rm -rf proto && cp -R src/grpc proto",
		"dev": "tsup src/index.ts --format esm,cjs --external @nestjs/microservices --external rxjs --dts --watch",
		"proto:gen": "protoc --ts_proto_out=src/generated --ts_proto_opt=nestJs=true --proto_path=src/grpc src/grpc/**/*.proto",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"zod": "^4.1.8"
	},
	"peerDependencies": {
		"@nestjs/microservices": "^11.1.8",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/microservices": "^11.1.8",
		"@types/node": "^22.20.3",
		"rxjs": "^7.8.2",
		"ts-proto": "^2.8.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
